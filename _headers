/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin

# The Meta Pixel needs three holes punched in the policies below, on every page
# that sends one: connect.facebook.net in script-src (fbevents.js, which
# /meta-pixel.js injects), www.facebook.com in img-src (the /tr beacon and the
# noscript fallback), and both in connect-src (the newer beacon transport). The
# pixel loader itself is served from /meta-pixel.js rather than inlined, so
# 'unsafe-inline' is still not granted anywhere.

/
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https://www.facebook.com; media-src 'self' blob:; script-src 'self' https://connect.facebook.net; style-src 'self'; connect-src 'self' https://connect.facebook.net https://www.facebook.com

/book
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https://www.facebook.com; media-src 'self' blob:; script-src 'self' https://connect.facebook.net; style-src 'self'; connect-src 'self' https://connect.facebook.net https://www.facebook.com

/service-terms
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https://www.facebook.com; script-src 'self' https://connect.facebook.net; style-src 'self'; connect-src 'self' https://connect.facebook.net https://www.facebook.com

