# The unsubscribe page is rendered by a function rather than served from the
# site, so it carries its own small stylesheet inline and needs 'unsafe-inline'
# in style-src for that one rule block. It runs no script at all — script-src is
# 'none' — and the only thing it can submit to is this origin. It is kept out of
# search results because the address carries a per-message token.
/unsubscribe
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:

# The manager app loads two third parties: Clover's card SDK, and the Google
# Maps JavaScript API for the dashboard job map. Maps needs more than a script
# origin — it fetches tiles and marker sprites as images from maps.gstatic.com
# and the *.googleapis.com/*.ggpht.com tile hosts, calls the geocoding and
# places endpoints over XHR, pulls its own font and stylesheet from Google
# Fonts, and starts blob-backed workers for the vector renderer. Each of those
# is a separate directive; miss one and the map draws blank instead of failing
# loudly.
/manager/*
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com https://*.gstatic.com https://*.ggpht.com; script-src 'self' https://checkout.clover.com https://checkout.sandbox.dev.clover.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; connect-src 'self' https://checkout.clover.com https://checkout.sandbox.dev.clover.com https://maps.googleapis.com; frame-src https://checkout.clover.com https://checkout.sandbox.dev.clover.com

# The worker must be revalidated every load, otherwise a cached copy keeps
# serving an old app shell to phones that already installed it.
/manager/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /manager/

/manager/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

/api/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Apple Pay domain verification. The file has no extension, so it would
# otherwise be served as application/octet-stream and offered as a download;
# Apple's verifier and anyone checking it by hand both want plain text. Kept out
# of search results and only briefly cacheable, since Apple re-fetches it when
# the merchant domain is re-verified or the payload is rotated.
/.well-known/apple-developer-merchantid-domain-association
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, nofollow
