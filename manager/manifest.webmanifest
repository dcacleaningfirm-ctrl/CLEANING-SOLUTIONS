{
  "name": "DCA Pro Manager",
  "short_name": "DCA Manager",
  "description": "Operations console for DCA Cleaning Solutions — booking, jobs, customers, crew and payments.",
  "id": "/manager/",
  "start_url": "/manager/",
  "scope": "/manager/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/manager/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/manager/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/manager/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Book an appointment",
      "short_name": "Book",
      "url": "/manager/?view=book",
      "icons": [{ "src": "/manager/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "url": "/manager/?view=jobs",
      "icons": [{ "src": "/manager/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Customers",
      "short_name": "Customers",
      "url": "/manager/?view=customers",
      "icons": [{ "src": "/manager/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Custom charge",
      "short_name": "Charge",
      "url": "/manager/?view=charges",
      "icons": [{ "src": "/manager/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
