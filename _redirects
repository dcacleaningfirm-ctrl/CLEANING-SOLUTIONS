# Netlify evaluates these top to bottom, and an unforced rule does NOT fire
# when a real file already exists at the requested path. That is why the old
# /privacy-policy 301 never took effect: privacy-policy.html was still on disk,
# so Google saw two live copies of the same policy. The file has been removed
# and these two rules are forced, so the duplicate cannot come back silently.
/privacy-policy       /privacy               301!
/privacy-policy.html  /privacy               301!

# Retired and duplicate paths, pointed at the page that replaced them.
/terms                /service-terms         301
/promotion            /promotions            301
/testimonials         /reviews               301
/refund-policy        /return-refund-policy  301
/returns              /return-refund-policy  301

# Short forms used on print material, vehicle signage and in call handling.
/carpet                       /carpet-cleaning                     301
/carpets                      /carpet-cleaning                     301
/air-ducts                    /air-duct-cleaning                   301
/duct-cleaning                /air-duct-cleaning                   301
/upholstery                   /upholstery-cleaning                 301
/designer-furniture-cleaning  /luxury-designer-furniture-cleaning  301
/move-in-cleaning             /move-in-move-out-cleaning           301
/move-out-cleaning            /move-in-move-out-cleaning           301
/move-cleaning                /move-in-move-out-cleaning           301
# A spoken or printed promo code is a URL. Each one lands on the request form
# with its own offer already selected.
